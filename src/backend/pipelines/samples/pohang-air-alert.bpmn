<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:pipeline="pipeline://" id="Defs_pohang_air" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_pohang_air" name="포항 대기질 경보" isExecutable="true">
    <bpmn:startEvent id="Start" name="시작" />
    <bpmn:serviceTask id="Pohang" name="포항 환경 통합 연합객체 최신 데이터">
      <bpmn:documentation>연합트윈 Digital Brain 의 포항 환경 통합 연합객체(KR-104111-0109)에서 최신 대기 관측값을 가져온다. 연합트윈이 input_data 로 값을 넘겨 호출하면 그 값이 먼저 들어있지만, 이 노드가 최신값으로 다시 확인한다.</bpmn:documentation>
      <bpmn:extensionElements><pipeline:parameters>
        <pipeline:parameter name="포항 환경 통합 연합객체 최신 데이터" url="/api/fedit/objects/latest?fdt=KR-01-O84213-20260004&amp;fdo=KR-104111-0109" method="GET" timeout="10" retry="1" />
        <pipeline:output name="pm10" /><pipeline:output name="pm25" /><pipeline:output name="temp" /><pipeline:output name="humi" /><pipeline:output name="observedAt" />
      </pipeline:parameters></bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:scriptTask id="Grade" name="대기질 등급 산출">
      <bpmn:documentation>환경부 PM10 예보 기준(좋음 0~30, 보통 31~80, 나쁨 81~150, 매우나쁨 151~)으로 등급을 매긴다.</bpmn:documentation>
      <bpmn:extensionElements><pipeline:parameters>
        <pipeline:input name="등급" source="'매우나쁨' if pm10 &gt; 150 else '나쁨' if pm10 &gt; 80 else '보통' if pm10 &gt; 30 else '좋음'" />
      </pipeline:parameters></bpmn:extensionElements>
    </bpmn:scriptTask>
    <bpmn:exclusiveGateway id="NeedAlert" name="경보 필요?" default="Flow_normal" />
    <bpmn:serviceTask id="Signage" name="디지털 사이니지 표출">
      <bpmn:extensionElements><pipeline:parameters>
        <pipeline:parameter name="디지털 사이니지 표출" url="/api/pipelines/run?id=notify.signage" />
        <pipeline:input name="표출문구" source="'미세먼지 ' + 등급 + ' (PM10 ' + str(pm10) + '㎍/㎥) 야외활동 자제'" />
        <pipeline:input name="대상지점" value="포항 영일만" />
        <pipeline:output name="표출상태" />
      </pipeline:parameters></bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Store" name="결과 저장">
      <bpmn:extensionElements><pipeline:parameters>
        <pipeline:parameter name="결과 저장" url="/api/pipelines/run?id=data.store" />
        <pipeline:input name="결과 데이터" source="{'등급': 등급, 'pm10': pm10, 'pm25': pm25, '측정시각': observedAt}" />
        <pipeline:output name="저장경로" />
      </pipeline:parameters></bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End" name="결과 반환">
      <bpmn:extensionElements><pipeline:parameters>
        <pipeline:input name="등급" /><pipeline:input name="pm10" /><pipeline:input name="pm25" />
        <pipeline:input name="기온" source="temp" /><pipeline:input name="측정시각" source="observedAt" />
        <pipeline:input name="경보" source="등급 in ['나쁨', '매우나쁨']" />
      </pipeline:parameters></bpmn:extensionElements>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="Pohang" />
    <bpmn:sequenceFlow id="F2" sourceRef="Pohang" targetRef="Grade" />
    <bpmn:sequenceFlow id="F3" sourceRef="Grade" targetRef="NeedAlert" />
    <bpmn:sequenceFlow id="Flow_alert" name="나쁨 이상" sourceRef="NeedAlert" targetRef="Signage">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">등급 in ['나쁨', '매우나쁨']</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_normal" name="보통 이하" sourceRef="NeedAlert" targetRef="Store" />
    <bpmn:sequenceFlow id="F6" sourceRef="Signage" targetRef="Store" />
    <bpmn:sequenceFlow id="F7" sourceRef="Store" targetRef="End" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Dia_pohang_air"><bpmndi:BPMNPlane id="Plane_pohang_air" bpmnElement="Process_pohang_air">
    <bpmndi:BPMNShape id="Start_di" bpmnElement="Start"><dc:Bounds x="100" y="182" width="36" height="36" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Pohang_di" bpmnElement="Pohang"><dc:Bounds x="190" y="160" width="130" height="80" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Grade_di" bpmnElement="Grade"><dc:Bounds x="370" y="160" width="120" height="80" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="NeedAlert_di" bpmnElement="NeedAlert" isMarkerVisible="true"><dc:Bounds x="545" y="175" width="50" height="50" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Signage_di" bpmnElement="Signage"><dc:Bounds x="650" y="40" width="120" height="80" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Store_di" bpmnElement="Store"><dc:Bounds x="830" y="160" width="120" height="80" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="End_di" bpmnElement="End"><dc:Bounds x="1010" y="182" width="36" height="36" /></bpmndi:BPMNShape>
    <bpmndi:BPMNEdge id="F1_di" bpmnElement="F1"><di:waypoint x="136" y="200" /><di:waypoint x="190" y="200" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F2_di" bpmnElement="F2"><di:waypoint x="320" y="200" /><di:waypoint x="370" y="200" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F3_di" bpmnElement="F3"><di:waypoint x="490" y="200" /><di:waypoint x="545" y="200" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Flow_alert_di" bpmnElement="Flow_alert"><di:waypoint x="570" y="175" /><di:waypoint x="570" y="80" /><di:waypoint x="650" y="80" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Flow_normal_di" bpmnElement="Flow_normal"><di:waypoint x="595" y="200" /><di:waypoint x="830" y="200" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F6_di" bpmnElement="F6"><di:waypoint x="770" y="80" /><di:waypoint x="890" y="80" /><di:waypoint x="890" y="160" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F7_di" bpmnElement="F7"><di:waypoint x="950" y="200" /><di:waypoint x="1010" y="200" /></bpmndi:BPMNEdge>
  </bpmndi:BPMNPlane></bpmndi:BPMNDiagram>
</bpmn:definitions>
