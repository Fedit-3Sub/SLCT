<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:pipeline="pipeline://" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="D_twin" targetNamespace="http://bpmn.io/schema/bpmn" exporter="kt-bpmn" exporterVersion="1.0.0"><bpmn:process id="P_twin" name="포항 대기·풍속 경보 (트윈 노드)" isExecutable="true"><bpmn:startEvent id="Start" name="시작" /><bpmn:serviceTask id="Air" name="포항 대기 환경 관측 객체"><bpmn:extensionElements><pipeline:parameters><pipeline:parameter name="포항 대기 환경 관측 객체" url="/api/twins/do/KR-01-O84213-20260002/KR-104111-0024/latest" twin="do:KR-01-O84213-20260002:KR-104111-0024" method="GET" /><pipeline:output name="pm10" /></pipeline:parameters></bpmn:extensionElements></bpmn:serviceTask><bpmn:serviceTask id="Sea" name="POHANG_WEATHER"><bpmn:extensionElements><pipeline:parameters><pipeline:parameter name="POHANG_WEATHER" url="/api/twins/do/KR-01-O84213-20260001/KR-104111-0023/latest" twin="do:KR-01-O84213-20260001:KR-104111-0023" method="GET" /><pipeline:output name="WIND_SPEED" /></pipeline:parameters></bpmn:extensionElements></bpmn:serviceTask><bpmn:exclusiveGateway id="Check" name="고농도·약풍?" default="No" /><bpmn:sendTask id="Alert" name="SMS 알림 발송"><bpmn:extensionElements><pipeline:parameters><pipeline:parameter name="SMS 알림 발송" url="/api/pipelines/run?id=notify.sms" method="POST" /><pipeline:input name="메시지" source="Air.pm10" /></pipeline:parameters></bpmn:extensionElements></bpmn:sendTask><bpmn:endEvent id="End" name="종료" /><bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="Air" /><bpmn:sequenceFlow id="F2" sourceRef="Air" targetRef="Sea" /><bpmn:sequenceFlow id="F3" sourceRef="Sea" targetRef="Check" /><bpmn:sequenceFlow id="Yes" name="경보" sourceRef="Check" targetRef="Alert"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Air.pm10 &gt; 30 and Sea.WIND_SPEED &lt; 20</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="No" name="정상" sourceRef="Check" targetRef="End" /><bpmn:sequenceFlow id="F6" sourceRef="Alert" targetRef="End" /></bpmn:process><bpmndi:BPMNDiagram id="Dg"><bpmndi:BPMNPlane id="Pl" bpmnElement="P_twin"><bpmndi:BPMNShape id="Start_di" bpmnElement="Start"><dc:Bounds x="160" y="182" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Air_di" bpmnElement="Air"><dc:Bounds x="250" y="160" width="120" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Sea_di" bpmnElement="Sea"><dc:Bounds x="420" y="160" width="120" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Check_di" bpmnElement="Check" isMarkerVisible="true"><dc:Bounds x="595" y="175" width="50" height="50" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Alert_di" bpmnElement="Alert"><dc:Bounds x="700" y="60" width="120" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="End_di" bpmnElement="End"><dc:Bounds x="882" y="182" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNEdge id="F1_di" bpmnElement="F1"><di:waypoint x="196" y="200" /><di:waypoint x="250" y="200" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="F2_di" bpmnElement="F2"><di:waypoint x="370" y="200" /><di:waypoint x="420" y="200" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="F3_di" bpmnElement="F3"><di:waypoint x="540" y="200" /><di:waypoint x="595" y="200" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Yes_di" bpmnElement="Yes"><di:waypoint x="620" y="175" /><di:waypoint x="620" y="100" /><di:waypoint x="700" y="100" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="No_di" bpmnElement="No"><di:waypoint x="645" y="200" /><di:waypoint x="882" y="200" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="F6_di" bpmnElement="F6"><di:waypoint x="820" y="100" /><di:waypoint x="900" y="100" /><di:waypoint x="900" y="182" /></bpmndi:BPMNEdge></bpmndi:BPMNPlane></bpmndi:BPMNDiagram></bpmn:definitions>